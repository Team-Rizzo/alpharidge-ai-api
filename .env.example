# Copy to .env. Every other setting has a default in app/config.py.

# Database (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/alpharidge

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Chain: finney, test, a ws:// endpoint, or mock for local tests
BT_NETWORK=finney
SUBNET_UID=45

# Request auth
# Only "false" turns it off, and only with SUBTENSOR_NETWORK=mock.
AUTH_ENABLED=true
AUTH_SIGNATURE_TIMEOUT=300
# Hotkeys allowed on /ops (comma-separated)
OPERATOR_HOTKEYS=
# Validators whose re-verify disagreements hold a claim (comma-separated)
REVERIFY_VALIDATORS=
# Extra peers allowed on internal-only routes; localhost is always allowed
INTERNAL_ALLOWED_IPS=

# Served to validators on /config/subnet (refreshed hourly; a validator's OVERRIDE_<KEY> wins).
# The page judge's endpoint and model go to REVERIFY_VALIDATORS only; each uses its own key.
VALIDATOR_EL_JUDGE_URL=
VALIDATOR_EL_JUDGE_MODEL=
# Optional: VALIDATOR_REVERIFY_FETCH_TIMEOUT_S, VALIDATOR_REVERIFY_DOMAIN_RPS,
# VALIDATOR_SCAN_INTERVAL_S, VALIDATOR_JUDGE_POLL_S. EL_USER_AGENT_CONTACT is served as well.

# Ledger and profile signing: 32-byte hex sr25519 seed (secret)
API_ATTESTATION_PRIVKEY=

# Product API keys (comma-separated; more can be added with scripts/api_keys.py)
PRODUCT_API_KEYS=

# Answer key: SEC requires a user agent naming the operator with a contact email
EL_AK_SEC_USER_AGENT=
# Contact URL or email for the AlphaRidgeBot user agent
EL_USER_AGENT_CONTACT=https://example.org/contact

# Scoops: an untrusted page can be held up to 72 h until a later trusted page confirms it
EL_SCOOPS=true

# Entity registry lookups (Wikidata, SEC, GLEIF), cached per ID. Needs EL_USER_AGENT_CONTACT
# (Wikimedia asks for a contact); without it lookups stay off. CIKs also need EL_AK_SEC_USER_AGENT.
EL_REGISTRY=http

# The page judge runs on the listed validators (REVERIFY_VALIDATORS). Claims a hotkey may send
# to it per UTC day, and per hotkey with no passes in 7 days.
# EL_JUDGE_HOTKEY_ITEMS=2666
# EL_JUDGE_NEW_HOTKEY_ITEMS=266

# Later re-check of paid sources: sampling key (secret)
EL_RECHECK_KEY=
# EL_RECHECK_PROXY=
# Required with a proxy: true only when the proxy refuses non-public addresses.
# EL_RECHECK_PROXY_PUBLIC_ONLY=false

# Settings with no public default; the API won't start until each is set. The values are
# kept by the operators.
EL_RECHECK_SAMPLE_RATE=
EL_RECHECK_LOW_TRUST=
EL_RECHECK_MIN_H=
EL_RECHECK_MAX_H=
EL_RECHECK_ACCEPT_LANGUAGE=
EL_RECHECK_NOTICES=
EL_PAGE_FLAG_DAYS=
EL_PAGE_FLAG_BYLINES_MIN=
EL_PAGE_FLAG_BYLINES_SHARE=
EL_PAGE_FLAG_CONTRIBUTOR_MIN=
EL_PAGE_FLAG_UNDATED_MIN=
EL_PAGE_FLAG_UNDATED_SHARE=
EL_PAGE_FLAG_MARKERS=
EL_ALARM_CLAW_DAYS=
EL_ALARM_CLAW_MIN=
EL_ALARM_CLAW_SHARE=
EL_ALARM_COLDKEY_HOTKEYS=
EL_ALARM_COLDKEY_MIN=
EL_ALARM_COLDKEY_SHARE=
EL_ALARM_FETCH_WINDOW_H=
EL_ALARM_FETCH_MIN=
EL_ALARM_FETCH_FAIL_SHARE=
EL_AUDIT_DAYS=
EL_AUDIT_N=
EL_AUDIT_MIN_N=
EL_AUDIT_ALARM_LB=
EL_HEDGE_GAP_S=
EL_TRUST_SPIKE_X=
EL_TRUST_SPIKE_MIN=
EL_TRUST_SPIKE_BASE_DAYS=
