/// Signed miner claim as received.
model Claim {
  id         BigInt   @id @default(autoincrement())
  hotkey     String
  signature  String
  nonce      String
  bodyHash   String   @map("body_hash")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  kind       String
  category   String
  eventType  String?  @map("event_type")
  payload    Json     @db.JsonB
  sourceUrl  String   @map("source_url")
  sourceId   Int?     @map("source_id")
  status     String   @default("received")
  reason     String?
  eventId    Int?     @map("event_id")

  signedAt         Int?      @map("signed_at")
  receiptBucket    BigInt?   @map("receipt_bucket")
  body             String?
  novelty          String?
  route            String?
  pendingOfEventId Int?      @map("pending_of_event_id")
  docHash          String?   @map("doc_hash")
  strike           Boolean   @default(false)
  strikeWeight     Int       @default(1) @map("strike_weight")
  held             Boolean   @default(false)
  trust            Float?
  trustBand        String?   @map("trust_band")
  wrong            String?
  coldkey          String?
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(3)
  judgedAt         DateTime? @map("judged_at") @db.Timestamptz(3)
  settleAt         DateTime? @map("settle_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  source        Source?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  event         Event?          @relation("EventClaims", fields: [eventId], references: [id], onDelete: SetNull)
  firstOf       Event?          @relation("EventFirstClaim")
  fetches       SourceFetch[]
  facts         EventFact[]
  stages        EventStage[]
  ledgerEntries LedgerEntry[]
  answerKeys    AnswerKeyItem[]
  accuracy      AccuracyCheck[]
  jobs          Job[]
  reverifies    ReverifyResult[]

  @@unique([hotkey, nonce], name: "uq_claim_hotkey_nonce")
  @@unique([hotkey, bodyHash], name: "uq_claim_hotkey_body")
  @@index([bodyHash], name: "idx_claim_body_hash")
  @@index([status, receiptBucket], name: "idx_claim_status_bucket")
  @@index([judgedAt], name: "idx_claim_judged")
  @@index([status, receivedAt], name: "idx_claim_status_received")
  @@index([hotkey, receivedAt], name: "idx_claim_hotkey_received")
  @@index([hotkey, updatedAt, id], name: "idx_claim_hotkey_updated")
  @@index([eventId], name: "idx_claim_event")
  @@map("claim")
}

