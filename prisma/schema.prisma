/// Legacy, frozen.
model Event {
  id              Int                         @id @default(autoincrement())
  fingerprint     String                      @unique
  eventType       String                      @map("event_type")
  canonicalTitle  String                      @map("canonical_title")
  eventDate       DateTime?                   @map("event_date") @db.Date
  sectorId        Int?                        @map("sector_id")
  sectorSymbol    String?                     @map("sector_symbol")
  articleCount    Int                         @default(1) @map("article_count")
  sentiment       String?
  impactPotential String?                     @map("impact_potential")
  entities        Json?                       @db.JsonB
  summary         String?
  titleEmbedding  Float[]                     @default([]) @map("title_embedding")
  category        String?
  identityKey     String?                     @unique @map("identity_key")
  firstClaimId    BigInt?                     @unique @map("first_claim_id")
  stage           String?
  placeIso2       String?                     @map("place_iso2")
  placeAdmin1     String?                     @map("place_admin1")
  confidence      String                      @default("reported")
  publishAt       DateTime?                   @map("publish_at") @db.Timestamptz(3)
  officialMatch   Boolean                     @default(false) @map("official_match")
  storylineId     Int?                        @map("storyline_id")
  hold            String?
  marked          String?
  embedding       Unsupported("vector(384)")?
  firstSeenAt     DateTime                    @default(now()) @map("first_seen_at") @db.Timestamptz
  lastArticleAt   DateTime                    @default(now()) @map("last_article_at") @db.Timestamptz
  updatedAt       DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  firstClaim     Claim?           @relation("EventFirstClaim", fields: [firstClaimId], references: [id], onDelete: SetNull)
  articles       EventArticle[]
  narrativeLinks EventNarrative[]
  claims         Claim[]          @relation("EventClaims")
  entityLinks    EventEntity[]
  facts          EventFact[]
  stages         EventStage[]
  ledgerEntries  LedgerEntry[]

  @@index([eventType], name: "idx_events_type")
  @@index([category, eventDate], name: "idx_events_category_date")
  @@index([eventDate], name: "idx_events_date")
  @@index([sectorId], name: "idx_events_sector")
