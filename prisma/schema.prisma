  claim Claim? @relation(fields: [claimId], references: [id], onDelete: Restrict)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([epoch, hotkey], name: "idx_ledger_epoch_hotkey")
  @@index([hotkey, createdAt], name: "idx_ledger_hotkey_created")
  @@index([claimId], name: "idx_ledger_claim")
  @@map("ledger_entry")
}

model AnswerKeyItem {
  id             BigInt    @id @default(autoincrement())
  adapter        String
  externalId     String    @map("external_id")
  payload        Json      @db.JsonB
  matchedClaimId BigInt?   @map("matched_claim_id")
  observedAt     DateTime  @default(now()) @map("observed_at") @db.Timestamptz(3)
  category       String?
  eventType      String?   @map("event_type")
  eventDate      DateTime? @map("event_date") @db.Date
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  status         String    @default("open")
  matchedEventId Int?      @map("matched_event_id")
  matchedAt      DateTime? @map("matched_at") @db.Timestamptz(3)

  matchedClaim Claim? @relation(fields: [matchedClaimId], references: [id], onDelete: SetNull)

  @@unique([adapter, externalId], name: "uq_answer_key_adapter_external")
  @@index([matchedClaimId], name: "idx_answer_key_claim")
  @@index([status, observedAt], name: "idx_answer_key_status_observed")
  @@map("answer_key_item")
}

model AccuracyCheck {
  id       BigInt   @id @default(autoincrement())
  claimId  BigInt   @map("claim_id")
  hotkey   String
  category String
  kind     String
  ref      String   @default("")
  correct  Boolean
  at       DateTime @default(now()) @db.Timestamptz(3)

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId, kind, ref], name: "uq_accuracy_check_claim_kind_ref")
  @@index([hotkey, category, at], name: "idx_accuracy_check_hotkey")
  @@map("accuracy_check")
}

model MinerAccuracy {
  id        Int      @id @default(autoincrement())
  hotkey    String
  category  String
  n         Int      @default(0)
  correct   Int      @default(0)
  q         Float
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([hotkey, category], name: "uq_miner_accuracy_hotkey_category")
  @@map("miner_accuracy")
}

model WebhookSubscription {
  id         Int      @id @default(autoincrement())
  ownerId    String   @map("owner_id")
  url        String
  secret     String
  categories String[] @default([])
  eventTypes String[] @default([]) @map("event_types")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  // Last feed seq queued for delivery.
  cursor     BigInt   @default(0)

  deliveries WebhookDelivery[]

  @@index([ownerId], name: "idx_webhook_subscription_owner")
  @@map("webhook_subscription")
}

model WebhookDelivery {
  id             BigInt   @id @default(autoincrement())
  subscriptionId Int      @map("subscription_id")
  seq            BigInt
  body           String
  status         String   @default("pending")
  attempts       Int      @default(0)
  nextAt         DateTime @default(now()) @map("next_at") @db.Timestamptz(3)
  error          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, seq], name: "uq_webhook_delivery_subscription_seq")
  @@index([status, nextAt], name: "idx_webhook_delivery_status_next")
  @@map("webhook_delivery")
}

/// Append-only product feed: event, stage, fact and confidence changes.
model FeedRecord {
  seq       BigInt   @id @default(autoincrement())
  at        DateTime @db.Timestamptz(3)
  kind      String
  eventId   Int      @map("event_id")
  category  String
  eventType String   @map("event_type")
  payload   Json     @db.JsonB

  @@index([eventId], name: "idx_feed_record_event")
  @@index([at], name: "idx_feed_record_at")
  @@map("feed_record")
}

/// Product API keys, stored as sha256 hashes.
model ApiKey {
  id        Int      @id @default(autoincrement())
  keyHash   String   @unique @map("key_hash")
  ownerId   String   @map("owner_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("api_key")
}

/// Work queue for claim processing.
model Job {
  id        BigInt    @id @default(autoincrement())
  kind      String
  claimId   BigInt?   @map("claim_id")
  status    String    @default("pending")
  attempts  Int       @default(0)
  runAt     DateTime  @default(now()) @map("run_at") @db.Timestamptz(3)
  lockedAt  DateTime? @map("locked_at") @db.Timestamptz(3)
  error     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  claim Claim? @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([status, kind, runAt], name: "idx_job_status_kind_run")
  @@index([claimId], name: "idx_job_claim")
  @@map("job")
}

model CategoryWeight {
  id          Int      @id @default(autoincrement())
  weekStart   DateTime @map("week_start") @db.Date
  category    String
  weight      Float
  targetShare Float    @map("target_share")
  actualShare Float?   @map("actual_share")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([weekStart, category], name: "uq_category_weight_week")
  @@map("category_weight")
}

model ReverifyResult {
  id              Int      @id @default(autoincrement())
  claimId         BigInt   @map("claim_id")
  validatorHotkey String   @map("validator_hotkey")
  epoch           Int
  verdict         String
  observed        Json     @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId, validatorHotkey], name: "uq_reverify_claim_validator")
  @@index([epoch], name: "idx_reverify_epoch")
  @@map("reverify_result")
}

model ReverifyPull {
  id              Int       @id @default(autoincrement())
  validatorHotkey String    @map("validator_hotkey")
  epoch           Int
  at              DateTime  @default(now()) @db.Timestamptz(3)
  reportedAt      DateTime? @map("reported_at") @db.Timestamptz(3)

  @@index([validatorHotkey, epoch], name: "idx_reverify_pull_validator_epoch")
  @@map("reverify_pull")
}
