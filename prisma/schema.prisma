  xrefs      String[] @default([])
  // Official website (Wikidata P856), for primary-source trust.
  website    String?
  // "linked" or "unclear"; registry rows are frozen at `revision`.
  status     String   @default("linked")
  // "seed", "override" or "registry".
  origin     String   @default("seed")
  revision   String?
  checkedAt  DateTime? @map("checked_at") @db.Timestamptz
