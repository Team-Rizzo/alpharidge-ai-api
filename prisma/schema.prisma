/// Published mechanism profiles: one signed, versioned object carrying every economic
/// value validators resolve by block height. Append-only. There is no edit or delete
/// path; rolling back is publishing the old body under a higher version, so the served
/// history is the whole record of what the mechanism has ever been.
model MechanismProfile {
  version         Int      @id
  publishBlock    Int      @map("publish_block")
  activationBlock Int      @map("activation_block")
  schemaVersion   String   @map("schema_version")
  body            Json
  signature       String
